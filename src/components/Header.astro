---
import { NAV, SITE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-header">
  <div class="container masthead">
    <a class="brand" href={`${base}/`}>{SITE.title}</a>
    <nav class="site-nav" aria-label="Main">
      {
        NAV.map(({ href, label }) => (
          <a href={`${base}${href}`} aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" aria-label="Toggle color theme">
        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
        </svg>
        <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
