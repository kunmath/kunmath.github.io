---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPublishedPosts, readingTime, type Post } from '../../lib/posts';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {formatDate(post.data.date)}
        </time>
        <span>·</span>
        <span>{readingTime(post.body ?? '')} min read</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-footer">
      <a href={`${base}/blog/`}>← All posts</a>
      <span class="byline">{SITE.author} · {SITE.role}</span>
    </footer>
  </article>
</Base>
